<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Attest.Core\Attest.Core.csproj" />
    <ProjectReference Include="..\Attest.NET\Attest.NET.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Attest.UnitTests" />
    <InternalsVisibleTo Include="Attest.IntegrationTests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>attest</ToolCommandName>
    <PackageId>Attest.Cli</PackageId>
    <Description>The Attest.NET dotnet tool: `attest --diff` proposes and refutes property-based tests for your diff, `attest init` scaffolds attest.json, `attest doctor` checks the environment before anything costs money.</Description>
  </PropertyGroup>

</Project>

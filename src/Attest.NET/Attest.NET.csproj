<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Attest.Core\Attest.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FsCheck" Version="3.3.4" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Attest.PropertyTests" />
    <InternalsVisibleTo Include="Attest.UnitTests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Property-based tests that carry proof. An LLM proposes properties for the code you changed; Attest refutes each one against your real code and against Stryker.NET mutants of it. Only survivors ship, each with the mutant it killed as evidence.</Description>
    <PackageTags>property-based-testing;mutation-testing;fscheck;stryker;llm;testing</PackageTags>
  </PropertyGroup>

</Project>
